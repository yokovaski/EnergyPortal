# Copy to .env (next to docker-compose.yml) and fill in. The .env file is gitignored.

# KNMI Open Data API key for outdoor temperature. Empty = the worker skips temperatures.
KNMI_API_KEY=

# SMTP account for account mails (password reset, e-mail confirmation). Empty = no mail;
# the pages then say that mail is unavailable.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<address>, SMTP_PASSWORD=<app password>.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Sender address; defaults to SMTP_USER. With Gmail it must be that account or one of its aliases.
SMTP_FROM=
