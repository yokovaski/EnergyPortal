@model ErrorViewModel
@{
    Layout = "_AuthLayout";
    var notFound = ViewData["StatusCode"] as int? == 404;
    ViewData["Title"] = notFound ? "Pagina niet gevonden" : "Er ging iets mis";
}

<h1 class="ez-title-lg">@ViewData["Title"]</h1>
@if (notFound)
{
    <p class="mt-2 mb-0 text-ink-muted">Deze pagina bestaat niet (meer). Controleer het adres of ga terug naar Actueel.</p>
}
else
{
    <p class="mt-2 mb-0 text-ink-muted">Probeer het later opnieuw.</p>
    @if (Model?.ShowRequestId == true)
    {
        <p class="ez-caption mt-2 mb-0">Foutcode: @Model.RequestId</p>
    }
}
<a class="ez-btn ez-btn-primary mt-6 h-11 w-full" href="/">Naar Actueel</a>
