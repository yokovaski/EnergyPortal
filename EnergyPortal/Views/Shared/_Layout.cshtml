<!DOCTYPE html>
<html lang="nl">
<head>
    <partial name="_Head" model='"app"' />
</head>
<body>
    <div id="app"></div>
    @RenderBody()
    @* Posted by the Vue avatar menu ("Uitloggen"); lives outside #app so it carries the antiforgery token. *@
    <form id="logout-form" method="post" action="/Identity/Account/Logout" hidden>@Html.AntiForgeryToken()</form>
</body>
</html>
