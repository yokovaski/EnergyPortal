@page
@model LoginWith2faModel
@{
    ViewData["Title"] = "Bevestig dat jij het bent";
}

<h1 class="ez-title-lg">Bevestig dat jij het bent</h1>
<p class="mt-1 mb-0 text-ink-muted">Vul de code van 6 cijfers uit je authenticator-app in.</p>

<form method="post" asp-route-returnUrl="@Model.ReturnUrl" novalidate>
    <input asp-for="RememberMe" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="ez-alert" role="alert"></div>

    <div class="ez-field">
        <label asp-for="Input.TwoFactorCode">Code</label>
        <input asp-for="Input.TwoFactorCode" class="ez-input ez-code-input" inputmode="numeric" autocomplete="one-time-code" maxlength="7" autofocus />
        <span asp-validation-for="Input.TwoFactorCode" class="ez-field-error"></span>
    </div>

    <label class="ez-check">
        <input asp-for="Input.RememberMachine" />
        Dit apparaat 30 dagen onthouden
    </label>

    <button type="submit" class="ez-btn ez-btn-primary mt-6 h-11 w-full">Bevestigen</button>
</form>

<p class="mt-6 mb-0">Geen toegang tot je app? <a class="ez-link" asp-page="./LoginWithRecoveryCode" asp-route-returnUrl="@Model.ReturnUrl">Gebruik een herstelcode</a></p>
<p class="mt-2 mb-0"><a class="ez-link" asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Terug naar inloggen</a></p>
