@page
@model ResetAuthenticatorModel
@{
    ViewData["Title"] = "Authenticator-app opnieuw instellen";
}

<nav aria-label="Kruimelpad" class="ez-label">
    <a class="ez-link" href="/settings">Instellingen</a> <span aria-hidden="true">›</span> <a class="ez-link" asp-page="./Index">Account</a>
</nav>
<h1 class="ez-title-lg mt-1">Authenticator-app opnieuw instellen</h1>
<section class="ez-card mt-6 max-w-[640px]">
    <p class="m-0">Je krijgt een nieuwe sleutel. <strong>De codes uit je huidige app werken daarna niet meer</strong> en tweestapsverificatie staat uit tot je de app opnieuw hebt ingesteld.</p>
    <form id="reset-authenticator-form" method="post" class="mt-6 flex gap-2">
        <button type="submit" class="ez-btn ez-btn-danger">Nieuwe sleutel maken</button>
        <a class="ez-btn" asp-page="./Index" asp-fragment="tweestapsverificatie">Annuleren</a>
    </form>
</section>
