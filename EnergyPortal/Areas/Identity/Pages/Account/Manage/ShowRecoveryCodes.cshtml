@page
@model ShowRecoveryCodesModel
@{
    ViewData["Title"] = "Herstelcodes";
}

<nav aria-label="Kruimelpad" class="ez-label">
    <a class="ez-link" href="/settings">Instellingen</a> <span aria-hidden="true">›</span> <a class="ez-link" asp-page="./Index">Account</a>
</nav>
<h1 class="ez-title-lg mt-1">Herstelcodes</h1>
<section class="ez-card mt-6 max-w-[640px]">
    <partial name="_StatusMessage" for="StatusMessage" />
    <p class="m-0"><strong>Bewaar deze codes op een veilige plek.</strong> Ben je je telefoon kwijt, dan log je met een van deze codes in. Elke code werkt één keer.</p>
    <ul class="ez-meter mt-4 mb-0 grid list-none grid-cols-2 gap-2 rounded-md bg-surface-sunken p-4 max-[400px]:grid-cols-1">
        @foreach (var code in Model.RecoveryCodes)
        {
            <li>@code</li>
        }
    </ul>
    <a class="ez-btn ez-btn-primary mt-6" asp-page="./Index" asp-fragment="tweestapsverificatie">Klaar</a>
</section>
