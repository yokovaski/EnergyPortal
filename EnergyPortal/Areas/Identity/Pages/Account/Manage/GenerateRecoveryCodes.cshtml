@page
@model GenerateRecoveryCodesModel
@{
    ViewData["Title"] = "Nieuwe herstelcodes maken";
}

<nav aria-label="Kruimelpad" class="ez-label">
    <a class="ez-link" href="/settings">Instellingen</a> <span aria-hidden="true">›</span> <a class="ez-link" asp-page="./Index">Account</a>
</nav>
<h1 class="ez-title-lg mt-1">Nieuwe herstelcodes maken</h1>
<section class="ez-card mt-6 max-w-[640px]">
    <p class="m-0">Je krijgt 10 nieuwe codes. <strong>De oude codes werken daarna niet meer.</strong></p>
    <p class="mt-2 mb-0 text-ink-muted">Je authenticator-app blijft gewoon werken.</p>
    <form method="post" class="mt-6 flex gap-2">
        <button type="submit" class="ez-btn ez-btn-primary">Nieuwe codes maken</button>
        <a class="ez-btn" asp-page="./Index" asp-fragment="tweestapsverificatie">Annuleren</a>
    </form>
</section>
