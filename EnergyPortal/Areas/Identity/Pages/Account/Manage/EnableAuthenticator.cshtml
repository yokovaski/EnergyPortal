@page
@model EnableAuthenticatorModel
@{
    ViewData["Title"] = "Authenticator-app instellen";
}

<nav aria-label="Kruimelpad" class="ez-label">
    <a class="ez-link" href="/settings">Instellingen</a> <span aria-hidden="true">›</span> <a class="ez-link" asp-page="./Index">Account</a>
</nav>
<h1 class="ez-title-lg mt-1">Authenticator-app instellen</h1>
<section class="ez-card mt-6 max-w-[640px]">
    <partial name="_StatusMessage" for="StatusMessage" />
    <ol class="m-0 flex list-decimal flex-col gap-4 pl-5">
        <li>Installeer een authenticator-app op je telefoon, zoals Microsoft Authenticator, Google Authenticator of een wachtwoordmanager met codes.</li>
        <li>
            Voeg een account toe met deze sleutel. Spaties en hoofdletters maken niet uit.
            <p class="ez-meter mt-2 mb-0 rounded-md bg-surface-sunken px-3 py-2 break-all">@Model.SharedKey</p>
            <p class="ez-help">Op je telefoon? <a class="ez-link" href="@Model.AuthenticatorUri">Open de sleutel direct in je app</a>.</p>
        </li>
        <li>
            Vul de code van 6 cijfers in die je app nu toont.
            <form id="send-code" method="post" class="max-w-[280px]" novalidate>
                <div asp-validation-summary="ModelOnly" class="ez-alert" role="alert"></div>
                <div class="ez-field">
                    <label asp-for="Input.Code">Code</label>
                    <input asp-for="Input.Code" class="ez-input ez-code-input" inputmode="numeric" autocomplete="one-time-code" maxlength="7" />
                    <span asp-validation-for="Input.Code" class="ez-field-error"></span>
                </div>
                <div class="mt-4 flex gap-2">
                    <button type="submit" class="ez-btn ez-btn-primary">Bevestigen</button>
                    <a class="ez-btn" asp-page="./Index" asp-fragment="tweestapsverificatie">Annuleren</a>
                </div>
            </form>
        </li>
    </ol>
</section>
