@page
@model Disable2faModel
@{
    ViewData["Title"] = "Tweestapsverificatie uitzetten";
}

<nav aria-label="Kruimelpad" class="ez-label">
    <a class="ez-link" href="/settings">Instellingen</a> <span aria-hidden="true">›</span> <a class="ez-link" asp-page="./Index">Account</a>
</nav>
<h1 class="ez-title-lg mt-1">Tweestapsverificatie uitzetten</h1>
<section class="ez-card mt-6 max-w-[640px]">
    <p class="m-0">Je account is daarna alleen met je wachtwoord beveiligd. Je authenticator-app blijft gekoppeld, zodat je het later weer aan kunt zetten.</p>
    <p class="mt-2 mb-0 text-ink-muted">Wil je een nieuwe sleutel voor je app? <a class="ez-link" asp-page="./ResetAuthenticator">Stel de app opnieuw in</a>.</p>
    <form method="post" class="mt-6 flex gap-2">
        <button type="submit" class="ez-btn ez-btn-danger">Uitzetten</button>
        <a class="ez-btn" asp-page="./Index" asp-fragment="tweestapsverificatie">Annuleren</a>
    </form>
</section>
