@page
@model LoginWithRecoveryCodeModel
@{
    ViewData["Title"] = "Inloggen met een herstelcode";
}

<h1 class="ez-title-lg">Inloggen met een herstelcode</h1>
<p class="mt-1 mb-0 text-ink-muted">Gebruik een van de herstelcodes die je hebt bewaard. Elke code werkt één keer.</p>

<form method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="ez-alert" role="alert"></div>

    <div class="ez-field">
        <label asp-for="Input.RecoveryCode">Herstelcode</label>
        <input asp-for="Input.RecoveryCode" class="ez-input" autocomplete="off" autofocus />
        <span asp-validation-for="Input.RecoveryCode" class="ez-field-error"></span>
    </div>

    <button type="submit" class="ez-btn ez-btn-primary mt-6 h-11 w-full">Inloggen</button>
</form>

<p class="mt-6 mb-0"><a class="ez-link" asp-page="./Login">Terug naar inloggen</a></p>
