@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Kijk in je mail";
}

<h1 class="ez-title-lg">Kijk in je mail</h1>
<p class="mt-2 mb-0 text-ink-muted">Als dit e-mailadres bij een account hoort, hebben we een link gestuurd om een nieuw wachtwoord in te stellen.</p>
<a class="ez-btn ez-btn-primary mt-6 h-11 w-full" asp-page="./Login">Naar inloggen</a>
