@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Nieuw wachtwoord instellen";
}

<h1 class="ez-title-lg">Nieuw wachtwoord instellen</h1>

<form method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="ez-alert" role="alert"></div>
    <input asp-for="Input.Code" type="hidden" />

    <div class="ez-field">
        <label asp-for="Input.Email">E-mailadres</label>
        <input asp-for="Input.Email" class="ez-input" autocomplete="username" />
        <span asp-validation-for="Input.Email" class="ez-field-error"></span>
    </div>

    <div class="ez-field">
        <label asp-for="Input.Password">Nieuw wachtwoord</label>
        <div class="ez-pw">
            <input asp-for="Input.Password" class="ez-input" autocomplete="new-password" aria-describedby="pw-help" />
            <button type="button" data-toggle-password="Input_Password" aria-pressed="false" aria-label="Wachtwoord tonen">Toon</button>
        </div>
        <p id="pw-help" class="ez-help">Minimaal 6 tekens, met een hoofdletter, een kleine letter, een cijfer en een leesteken.</p>
        <span asp-validation-for="Input.Password" class="ez-field-error"></span>
    </div>

    <div class="ez-field">
        <label asp-for="Input.ConfirmPassword">Herhaal nieuw wachtwoord</label>
        <input asp-for="Input.ConfirmPassword" class="ez-input" autocomplete="new-password" />
        <span asp-validation-for="Input.ConfirmPassword" class="ez-field-error"></span>
    </div>

    <button type="submit" class="ez-btn ez-btn-primary mt-6 h-11 w-full">Wachtwoord opslaan</button>
</form>
