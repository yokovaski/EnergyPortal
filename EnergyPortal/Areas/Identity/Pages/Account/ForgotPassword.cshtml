@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Wachtwoord vergeten";
}

<h1 class="ez-title-lg">Wachtwoord vergeten</h1>
<p class="mt-1 mb-0 text-ink-muted">Vul je e-mailadres in. We sturen je een link om een nieuw wachtwoord in te stellen.</p>

<form method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="ez-alert" role="alert"></div>

    <div class="ez-field">
        <label asp-for="Input.Email">E-mailadres</label>
        <input asp-for="Input.Email" class="ez-input" autocomplete="username" autofocus />
        <span asp-validation-for="Input.Email" class="ez-field-error"></span>
    </div>

    <button type="submit" class="ez-btn ez-btn-primary mt-6 h-11 w-full">Link sturen</button>
</form>

<p class="mt-6 mb-0"><a class="ez-link" asp-page="./Login">Terug naar inloggen</a></p>
