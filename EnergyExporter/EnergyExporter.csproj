<Project Sdk="Microsoft.NET.Sdk.Worker">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <UserSecretsId>dotnet-EnergyExporter-ccdf5964-9135-4e82-bf0e-bd1390c5e44a</UserSecretsId>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    </PropertyGroup>
    
    <ItemGroup>
        <PackageReference Include="Dapper.Extensions.PostgreSQL" Version="5.3.1" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
        <PackageReference Include="Dapper.Extensions.MySQL" Version="5.3.1" />
        <!-- Pinned above the transitive 2.4.0: GHSA-473q-m89c-ghf8 (fixed in 2.6.1) -->
        <PackageReference Include="MySqlConnector" Version="2.6.2" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\DatabaseInterface\DatabaseInterface.csproj" />
    </ItemGroup>

</Project>
